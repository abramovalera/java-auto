@@ require: (?s)(?:\bclass\s+Rocket\w+.*?){10} | Нужно 10 классов с именами из таблицы (все начинаются с Rocket)
@@ require: \bclass\s+RocketPressureSensor\b | На дне цепочки — класс RocketPressureSensor
@@ require: (?s)(?:\bnew\s+Rocket\w+\s*\(.*?){9} | Каждое звено создаёт соседа через new: нужно 9 вызовов new Rocket…() (пульт в main и 8 соседей в полях)
@@ require: int\s+measure\s*\(\s*int\s+\w+\s*\) | Датчик: метод int measure(int pressure)
@@ require: \.launch\s*\( | main делает один вызов: panel.launch(mission, pressure)
@@ forbid: static\s+\w+\s+(launch|prepare|fill|drain|pump|open|start|spark|measure)\s*\( | Методы цепочки — методы объектов, без static
